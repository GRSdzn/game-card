repeat = 1
effects = Array[ExtResource("3")]([SubResource("Cost"), SubResource("Gain")])

[resource]
script = ExtResource("1")
id = &"greed"
title_key = &"VICE_GREED_TITLE"
description_key = &"VICE_GREED_DESC"
rules = Array[ExtResource("2")]([SubResource("Rule")])
